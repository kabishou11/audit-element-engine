# =========================================
# 一、Qwen 多模态模型配置
# 作用：只用于“看图识别”阶段，读取图片文字、标题、金额、日期、印章、签名等视觉事实
# 建议：多模态阶段优先使用 Qwen / ModelScope，温度建议 0
# =========================================
VISION_API_KEY=
VISION_BASE_URL=https://api-inference.modelscope.cn/v1
VISION_MODEL=Qwen/Qwen3.5-35B-A3B
VISION_TEMPERATURE=0
VISION_MAX_TOKENS=4096
VISION_TIMEOUT_SECONDS=180

# =========================================
# 二、MiniMax 文本模型配置
# 作用：供“单图分类 / 要素提取 / 审计问题 / 整凭证汇总”这些纯文本阶段使用
# 说明：如果不填写 MINIMAX_API_KEY，则文本阶段会自动回退到 Qwen
# 建议：文本阶段优先使用 MiniMax，成本和压力通常低于全部走多模态模型
# =========================================
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TEMPERATURE=0.1
MINIMAX_MAX_TOKENS=4096
MINIMAX_TIMEOUT_SECONDS=120
MINIMAX_REASONING_SPLIT=false

# =========================================
# 三、单图分类阶段配置
# 作用：在“本地规则召回候选”之后，只在候选集内裁决最终附件类型
# MODEL_SOURCE 可选：minimax / vision
# 含义：minimax=走 MiniMax 配置；vision=走 Qwen/ModelScope 配置
# 建议：优先 minimax，温度建议 0
# =========================================
CLASSIFIER_MODEL_SOURCE=minimax
CLASSIFIER_MODEL_NAME=
CLASSIFIER_TEMPERATURE=0
CLASSIFIER_MAX_TOKENS=2048
CLASSIFIER_TIMEOUT_SECONDS=120

# =========================================
# 四、审计要素提取阶段配置
# 作用：只从 Excel 对应行的 AI审计要素 中选取字段并填值
# MODEL_SOURCE 可选：minimax / vision
# 含义：minimax=走 MiniMax 配置；vision=走 Qwen/ModelScope 配置
# 建议：优先 minimax，温度建议 0
# =========================================
EXTRACTOR_MODEL_SOURCE=minimax
EXTRACTOR_MODEL_NAME=
EXTRACTOR_TEMPERATURE=0
EXTRACTOR_MAX_TOKENS=2048
EXTRACTOR_TIMEOUT_SECONDS=120

# =========================================
# 五、单图审计问题生成阶段配置
# 作用：只从 Excel 的“审计对应问题”中选择命中项，再生成问题描述和建议
# MODEL_SOURCE 可选：minimax / vision
# 含义：minimax=走 MiniMax 配置；vision=走 Qwen/ModelScope 配置
# 建议：优先 minimax，温度建议 0
# =========================================
AUDIT_MODEL_SOURCE=minimax
AUDIT_MODEL_NAME=
AUDIT_TEMPERATURE=0
AUDIT_MAX_TOKENS=2048
AUDIT_TIMEOUT_SECONDS=120

# =========================================
# 六、整凭证汇总阶段配置
# 作用：对整个子文件夹做主类型判断、类型分布、证据链、整凭证要素和整凭证审计
# MODEL_SOURCE 可选：minimax / vision
# 含义：minimax=走 MiniMax 配置；vision=走 Qwen/ModelScope 配置
# 建议：优先 minimax，温度建议 0，token 可略高
# =========================================
FOLDER_MODEL_SOURCE=minimax
FOLDER_MODEL_NAME=
FOLDER_TEMPERATURE=0
FOLDER_MAX_TOKENS=3072
FOLDER_TIMEOUT_SECONDS=180

# =========================================
# 七、本地规则与提示词路径
# 作用：三层结构中的“本地规则召回”依赖这些文件
# =========================================
RULES_EXCEL_PATH=参考规则数据/副本凭证附件类型V1.2.xlsx
CLASSIFICATION_PROMPT_PATH=参考规则数据/system.txt
VISUAL_ANALYSIS_PROMPT_PATH=参考规则数据/system1.txt
ATTACHMENT_ROOT=凭证附件
OUTPUT_ROOT=outputs

# =========================================
# 八、本地规则召回参数
# 作用：控制候选附件类型召回的宽松程度
# 建议参数：
# - RULE_RECALL_TOP_K=5：每张图保留 5 个候选类型
# - RULE_RECALL_MIN_SCORE=0.05：过低会召回过多噪声，过高会漏召回
# - RULE_ALIAS_BONUS：完整命中附件类型别名的加权
# - RULE_FRAGMENT_BONUS：命中“审批/回单/报价”等短片段的加权
# - RULE_ELEMENT_BONUS：命中 AI审计要素字段名的加权
# - RULE_BIGRAM_WEIGHT：描述文本相似度的加权
# =========================================
RULE_RECALL_TOP_K=5
RULE_RECALL_MIN_SCORE=0.05
RULE_ALIAS_BONUS=3.0
RULE_FRAGMENT_BONUS=0.4
RULE_ELEMENT_BONUS=1.2
RULE_BIGRAM_WEIGHT=2.0

# =========================================
# 九、通用运行配置
# =========================================
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.webp,.tif,.tiff
LOG_LEVEL=INFO

# =========================================
# 十、后台任务稳定性配置
# 作用：控制任务日志、模型重试、单图处理超时
# 建议：
# - TASK_LOG_ENABLED=true：开启任务日志，便于排查卡住在哪张图/哪个阶段
# - MODEL_MAX_RETRIES=2：模型请求失败后最多重试 2 次
# - MODEL_RETRY_BACKOFF_SECONDS=2：每次重试前递增等待
# - SINGLE_IMAGE_TIMEOUT_SECONDS=600：单张图总处理超时 10 分钟后记失败并继续下一张
# =========================================
TASK_LOG_ENABLED=true
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=2
SINGLE_IMAGE_TIMEOUT_SECONDS=600
